{
  "name": "Тест MCP n8n - Напоминания важных событий",
  "nodes": [
    {
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "parameters": {
        "path": "reminder-bot",
        "httpMethod": "POST"
      }
    },
    {
      "id": "ai-agent",
      "name": "AI Agent - Обработка запросов",
      "type": "n8n-nodes-langchain.agent",
      "typeVersion": 1.0,
      "position": [450, 300],
      "parameters": {
        "model": "gpt-4o-mini",
        "systemMessage": "Ты - помощник для управления напоминаниями важных событий. Ты можешь:\n1. Добавлять новые события в календарь\n2. Обновлять существующие события\n3. Удалять события\n4. Показывать список событий\n5. Напоминать о предстоящих событиях\n\nИспользуй доступные инструменты для работы с календарем. Отвечай на русском языке.",
        "tools": []
      }
    },
    {
      "id": "set-response",
      "name": "Set Response",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.3,
      "position": [650, 300],
      "parameters": {
        "values": {
          "string": [
            {
              "name": "response",
              "value": "Событие обработано: {{ $json.message || 'Запрос получен' }}"
            }
          ]
        }
      }
    },
    {
      "id": "respond-to-webhook",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [850, 300],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}"
      }
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "AI Agent - Обработка запросов",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AI Agent - Обработка запросов": {
      "main": [
        [
          {
            "node": "Set Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set Response": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "saveManualExecutions": true,
    "saveExecutionProgress": true
  }
}
